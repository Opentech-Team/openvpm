# Copy to docker/.env.demo and fill in. Generate secrets with: openssl rand -base64 32
OPENVPM_LANGUAGE=es-VE
POSTGRES_PASSWORD=
MINIO_ROOT_PASSWORD=
NEXTAUTH_SECRET=
# Public host name that resolves to the server; sslip.io works without a domain:
# DEMO_HOST=203-0-113-7.sslip.io  and  NEXTAUTH_URL=https://203-0-113-7.sslip.io
DEMO_HOST=
NEXTAUTH_URL=https://
BUILD_NODE_OPTIONS=--max-old-space-size=3072
